# pnpm installs a git-hosted dependency inside its own directory. With the
# default isolated linker that produces a nested `node_modules/.pnpm` full of
# relative symlinks, and Node's ESM resolver fails on them on Windows
# (`EPERM: operation not permitted, stat ...\.pnpm\...\node_modules\...`), so the
# host cannot import this plugin at all. A hoisted linker keeps the peer
# dependencies as plain, statable directories.
node-linker=hoisted
